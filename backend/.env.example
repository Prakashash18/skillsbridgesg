# Copy to backend/.env and fill in. Missing keys are fine — the app degrades to
# deterministic/mock fallbacks. With OPENAI_API_KEY, AI profile conversation,
# role recommendation, gap analysis, and course search use the OpenAI client.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

APIFY_TOKEN=
APIFY_ACTOR_ID=

DATABASE_URL=sqlite:///./storage/skillbridge.db
